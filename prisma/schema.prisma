generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model TestResult {
  id         String   @id @default(uuid())
  createdAt  DateTime @default(now())
  testTitle  String
  score      Int
  maxScore   Int
  answers    String
  aiAnalysis String
  userEmail  String?
  userName   String?
}

model Product {
  id          String   @id @default(uuid())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  slug        String   @unique
  name        String
  subtitle    String?
  description String
  price       Float
  image       String
  category    String   // 'libro' | 'oraculo' | 'accesorio'
  stock       Int      @default(0)
  featured    Boolean  @default(false)
  active      Boolean  @default(true)
}

model Order {
  id            String      @id @default(uuid())
  createdAt     DateTime    @default(now())
  customerName  String
  customerEmail String
  customerPhone String
  address       String
  city          String
  country       String
  paymentMethod String
  status        String      @default("pending") // pending, paid, shipped, delivered
  total         Float
  items         OrderItem[]
}

model OrderItem {
  id        String  @id @default(uuid())
  orderId   String
  order     Order   @relation(fields: [orderId], references: [id])
  productId String
  name      String
  price     Float
  quantity  Int
}

model SanateMujerRegistration {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  name      String
  email     String
  whatsapp  String
}

model VenezuelaEnElCuerpoRegistration {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  name      String
  email     String
  whatsapp  String
  city      String
  scanned   Boolean  @default(false)
  scannedAt DateTime?
}

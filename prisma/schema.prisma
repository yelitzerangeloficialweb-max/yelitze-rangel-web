generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model TestResult {
  id         String   @id @default(uuid())
  createdAt  DateTime @default(now())
  testTitle  String
  score      Int
  maxScore   Int
  answers    String
  aiAnalysis String
  userEmail  String?
  userName   String?
}

model Product {
  id          String   @id @default(uuid())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  slug        String   @unique
  name        String
  subtitle    String?
  description String
  price       Float
  image       String
  images      String   @default("[]")
  category    String
  stock       Int      @default(0)
  featured    Boolean  @default(false)
  active      Boolean  @default(true)
}

model Order {
  id            String      @id @default(uuid())
  createdAt     DateTime    @default(now())
  customerName  String
  customerEmail String
  customerPhone String
  address       String
  city          String
  country       String
  paymentMethod String
  status        String      @default("pending")
  total         Float
  items         OrderItem[]
}

model OrderItem {
  id        String @id @default(uuid())
  orderId   String
  productId String
  name      String
  price     Float
  quantity  Int
  order     Order  @relation(fields: [orderId], references: [id])
}

model SanateMujerRegistration {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  name      String
  email     String
  whatsapp  String
  city      String   @default("No especificada")
}

model VenezuelaEnElCuerpoRegistration {
  id        String    @id @default(uuid())
  createdAt DateTime  @default(now())
  name      String
  email     String
  whatsapp  String
  city      String
  scanned   Boolean   @default(false)
  scannedAt DateTime?
  instagram String?
}

model Availability {
  id               String   @id @default(uuid())
  date             DateTime @unique
  morningEnabled   Boolean  @default(false)
  afternoonEnabled Boolean  @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model Appointment {
  id            String   @id @default(uuid())
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  date          DateTime // The day of the booking
  slot          String   // "morning" or "afternoon"
  customerName  String
  customerEmail String
  customerPhone String
  meetingType   String   @default("online") // online, presencial
  paymentMethod String
  status        String   @default("pending") // pending, confirmed, cancelled
  notes         String?
}

model BlogPost {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  slug      String   @unique
  title     String
  excerpt   String
  content   String   // HTML content
  date      String   // Formatted date string for display (e.g., '19 de Abril, 2026')
  image     String
  category  String
  author    String   @default("Yelitze Rangel")
}
